APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
EXPOSE_DEBUG_TRACE=true

CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080,http://127.0.0.1:8080
LEGISLA_ADMIN_TOKEN=change-me
LEGISLA_INTERNAL_SECRET=change-me-internal
REQUIRE_CHAT_AUTH=false
USER_TOKEN_TTL_SECONDS=900
USER_UPLOAD_RETENTION_DAYS=30

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/legislaia
DATABASE_AUTO_CREATE=true
DATABASE_ECHO=false
PERSIST_BOOTSTRAP_TO_DB=true

LLM_PROVIDER=mock
LLM_MODEL=gpt-4.1-mini
USE_LANGGRAPH_AGENT=true
OPENAI_API_KEY=
GROQ_API_KEY=

EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
RERANKER_PROVIDER=heuristic
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_BLEND_WEIGHT=0.25
RERANKER_CANDIDATE_LIMIT=12
RETRIEVAL_BACKEND=auto
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_LIMIT=20
RETRIEVAL_MMR_LAMBDA=0.75

BOOTSTRAP_MANIFEST_PATH=backend/data/bootstrap/corpus_manifest.json
ENABLE_LEGACY_BOOTSTRAP_FALLBACK=true
INGEST_HTTP_TIMEOUT_SECONDS=20
INGEST_HTTP_MAX_RETRIES=2
MAINTENANCE_SCHEDULER_ENABLED=false
MAINTENANCE_AUTO_SYNC_ON_STARTUP=false
MAINTENANCE_CLEANUP_INTERVAL_SECONDS=900
MAINTENANCE_SYNC_INTERVAL_SECONDS=3600
MAINTENANCE_CLEANUP_BATCH_SIZE=200

MAX_UPLOAD_BYTES=8388608
RATE_LIMIT_REQUESTS_PER_MINUTE=60

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=legislaia-local
